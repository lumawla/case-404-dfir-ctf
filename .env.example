# Copy to .env (never commit .env).
# HTTP port for the API (it also serves the built web app in production).
PORT=8787
# Long random string. Organizers sign in to /admin with this value.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Secret used to key stored answer/join-code hashes. Long random string.
APP_SECRET=change-me-too
# SQLite database file location.
DATABASE_PATH=./data/case404.db
# Set to "production" behind HTTPS so cookies get the Secure flag.
NODE_ENV=development
# Optional: absolute path to the organizer answer key (defaults to private/organizer/answers.json).
# CASE_ANSWERS_PATH=/secure/location/answers.json
